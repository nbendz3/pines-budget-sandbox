{
  "name": "pines-budget-sandbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Budgeting sandbox for The Pines Resort: Sage actuals, driver-based department budgets, what-if scenarios, P&L and cash.",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "seed": "tsx server/seed.ts",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@vitejs/plugin-react": "^4.3.4",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "multer": "^2.5.0",
    "papaparse": "^5.4.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "vitest": "^2.1.8"
  }
}
